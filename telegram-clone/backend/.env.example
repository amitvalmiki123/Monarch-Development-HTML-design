PORT=8081
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Optional: enables the in-chat GIF picker. Get a free key from
# https://developers.giphy.com (Giphy) or https://klipy.com (Klipy, no
# throttling on their free tier). Leave blank to keep the GIF button
# disabled with a friendly "not set up yet" message.
GIF_PROVIDER=giphy
GIF_API_KEY=
